{
  "_comment": [
    "MCP configuration for the official Neo4j MCP server.",
    "GitHub: https://github.com/neo4j/mcp-neo4j",
    "",
    "This config goes in your Claude Code settings or Claude Desktop config.",
    "The Neo4j MCP server exposes tools for:",
    "  - Running Cypher queries (read/write)",
    "  - Getting database schema",
    "  - Exploring nodes and relationships",
    "",
    "Add to Claude Code via CLI:",
    "  claude mcp add neo4j -- npx -y @neo4j/mcp-neo4j",
    "",
    "Or add to ~/.claude/settings.json manually (see below)."
  ],
  "mcpServers": {
    "neo4j": {
      "command": "npx",
      "args": [
        "-y",
        "@neo4j/mcp-neo4j"
      ],
      "env": {
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_USERNAME": "neo4j",
        "NEO4J_PASSWORD": "password123"
      }
    }
  }
}
